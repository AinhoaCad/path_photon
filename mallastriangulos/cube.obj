# Cubo simple centrado en el origen
# 8 vértices
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Normales para las 6 caras
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0

# 12 triángulos (2 por cara)
# Cara frontal (z negativo)
f 1//1 2//1 3//1
f 1//1 3//1 4//1

# Cara trasera (z positivo)
f 5//2 7//2 6//2
f 5//2 8//2 7//2

# Cara inferior (y negativo)
f 1//3 5//3 6//3
f 1//3 6//3 2//3

# Cara superior (y positivo)
f 4//4 3//4 7//4
f 4//4 7//4 8//4

# Cara izquierda (x negativo)
f 1//5 4//5 8//5
f 1//5 8//5 5//5

# Cara derecha (x positivo)
f 2//6 6//6 7//6
f 2//6 7//6 3//6
